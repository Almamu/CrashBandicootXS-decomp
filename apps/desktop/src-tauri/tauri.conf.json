{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crash Data Editor",
  "mainBinaryName": "crash-editor",
  "version": "0.1.0",
  "identifier": "io.github.almamu.crashxs-editor",
  "build": {
    "frontendDist": "../../editor/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm --filter @crash/editor dev",
    "beforeBuildCommand": "pnpm --filter @crash/editor build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Crash Bandicoot XS decomp's data editor",
    "longDescription": "Edits the data of a checkout of the Crash Bandicoot XS decompilation (XS, N-Tranced, mods) through its tools/editor_server.py: needs Python 3.12 and the checkout.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
