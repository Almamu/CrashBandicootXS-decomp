
# All rules below take a source under graphics/ and produce the
# corresponding built file under $(GRAPHICS_BUILDDIR), mirroring the
# subdirectory layout, so graphics/ only ever holds editable sources.
# Every asset ends up as C initializer bytes (tools/bin2c.py) that a
# data table's definition #includes (docs/data.md, "Resources");
# data/data.s incbins no graphics.

# The lists that follow graphics/manifest.json (docs/graphics.md, "The
# manifest"): the tile sheets and BG packages with their bpp, the 16-colour
# PNG palettes, the graphics class objects and each one's prerequisites.
# Generated by tools/gfx_manifest.py make, so a new graphic (an entry with
# no ROM address) gets its rules from its entry.
GRAPHICS_MANIFEST_MK := $(GRAPHICS_BUILDDIR)/graphics_manifest.mk
$(GRAPHICS_MANIFEST_MK): graphics/manifest.json tools/gfx_manifest.py
	python3 tools/gfx_manifest.py make $@
include $(GRAPHICS_MANIFEST_MK)

# Palettes -> raw GBA .gbapal. Read as gbagfx reads them, plus the ROM's
# stray bit-15 entries, which tools/jasc_pal.py keeps in the red value's
# lowest bit (docs/graphics.md, "Palettes"). A standalone palette is JASC
# .pal text (the OBJ palettes, graphics/sprites/palettes/); a palette that
# belongs to one picture is that picture's PNG palette, which must have
# exactly the colours its manifest entry gives: 256, or 16 for the pictures
# in PALETTE_COLORS_16 (graphics_manifest.mk; png-to-gba --colors fails
# otherwise, so an editor that pads or trims the palette is caught).
$(GRAPHICS_BUILDDIR)/%.gbapal: graphics/%.pal tools/jasc_pal.py
	@mkdir -p $(dir $@)
	python3 tools/jasc_pal.py to-gba $< $@
$(GRAPHICS_BUILDDIR)/%.gbapal: graphics/%.png tools/jasc_pal.py
	@mkdir -p $(dir $@)
	python3 tools/jasc_pal.py png-to-gba $< $@ --colors $(if $(filter $*,$(PALETTE_COLORS_16)),16,256)

# The framed OBJ sprite sheets of the polar and jetpack families
# (graphics/vehicles/<family>/sprite_sheet/): each subdirectory is one
# distinct entity (one animation's worth of frame data - see
# docs/graphics.md, "Re-splitting into one file per entity"), containing
# one indexed PNG per frame, named so filename sort order matches original
# ROM frame order, with no sidecar metadata - a frame's own tile dimensions
# are just its PNG size / 8. gbagfx can't be used directly: each frame has
# a 4-byte non-pixel header not present in a plain PNG<->4bpp round trip.
# Explicit (non-pattern) rules, one per entity folder, so
# editing/adding/removing a frame PNG is tracked like any other
# prerequisite. The sheet's sheet.json lists the entities in the sheet's
# order (FRAMED_ENTITIES_<family>, tools/framed_gfx.py order).
FRAMED_SHEETS := polar jetpack
FRAMED_NAME_polar := POLAR
FRAMED_NAME_jetpack := JETPACK
framed_dir = graphics/vehicles/$(1)/sprite_sheet
$(foreach f,$(FRAMED_SHEETS),$(eval FRAMED_ENTITIES_$(f) := $(shell python3 tools/framed_gfx.py order $(call framed_dir,$(f)))))

define FRAMED_ENTITY_RULE
$(GRAPHICS_BUILDDIR)/vehicles/$(1)/sprite_sheet/$(2).bin: $$(sort $$(wildcard graphics/vehicles/$(1)/sprite_sheet/$(2)/*.png)) tools/framed_gfx.py
	@mkdir -p $$(dir $$@)
	python3 tools/framed_gfx.py to-bin-folder graphics/vehicles/$(1)/sprite_sheet/$(2) $$@
endef

# Split multi-record sprite sheets: each ROM asset below was originally one
# big LZ77 stream, so it must be recompressed as a single unit - every
# entity's converted bytes get concatenated back in the order of the
# sheet's sheet.json before compression.
define FRAMED_SHEET_RULE
$(GRAPHICS_BUILDDIR)/vehicles/$(1)/sprite_sheet.bin: $(foreach e,$(FRAMED_ENTITIES_$(1)),$(GRAPHICS_BUILDDIR)/vehicles/$(1)/sprite_sheet/$(e).bin) graphics/vehicles/$(1)/sprite_sheet/sheet.json
	@mkdir -p $$(dir $$@)
	cat $$(filter %.bin,$$^) > $$@
endef

# The byte offset of every frame in a sheet (FRAMED_<FAMILY>_<ENTITY>_<NN>),
# for the category families' pool_offset table_B arrays (polar_anim_family.cpp,
# jetpack_anim_family.cpp).
define FRAMED_HEADER_RULE
$(GRAPHICS_BUILDDIR)/vehicles/$(1)/sprite_sheet_frames.h: $(sort $(wildcard graphics/vehicles/$(1)/sprite_sheet/*/*.png)) graphics/vehicles/$(1)/sprite_sheet/sheet.json tools/framed_gfx.py
	@mkdir -p $$(dir $$@)
	python3 tools/framed_gfx.py header graphics/vehicles/$(1)/sprite_sheet $$@ --name $(FRAMED_NAME_$(1))
endef

$(foreach sheet,$(FRAMED_SHEETS),\
  $(foreach entity,$(FRAMED_ENTITIES_$(sheet)),\
    $(eval $(call FRAMED_ENTITY_RULE,$(sheet),$(entity)))))
$(foreach sheet,$(FRAMED_SHEETS),$(eval $(call FRAMED_SHEET_RULE,$(sheet))))
$(foreach sheet,$(FRAMED_SHEETS),$(eval $(call FRAMED_HEADER_RULE,$(sheet))))

# Generic LZ77 compression, used for every asset type above.
$(GRAPHICS_BUILDDIR)/%.lz: $(GRAPHICS_BUILDDIR)/% | $(GFX)
	@mkdir -p $(dir $@)
	$(GFX) $< $@

# PNG -> C const array (grit), see docs/graphics.md. grit does the pixel
# layout, gbagfx the byte-exact LZ77 (grit's own -gzl compressor does not
# reproduce the ROM's streams), tools/bin2c.py the initializer bytes that a
# data table's file #includes.

# The cutscene pictures (graphics/cutscenes/NN_<what>.png, gCutscenePictureNN):
# Mode 4 bitmaps, linear 8bpp. Their palette is the PNG's own (256
# colours, the .gbapal rule above), an uncompressed u16 array (bin2c
# --u16).
$(GRAPHICS_BUILDDIR)/cutscenes/%.img.bin: graphics/cutscenes/%.png | $(GRIT)
	@mkdir -p $(dir $@)
	$(GRIT) $< -gb -gB8 -p! -ftb -fh! -o $(@:.img.bin=)
$(GRAPHICS_BUILDDIR)/cutscenes/%.pal.inc: $(GRAPHICS_BUILDDIR)/cutscenes/%.gbapal tools/bin2c.py
	python3 tools/bin2c.py $< $@ --u16

# Tile sheets: grit -gt, 4bpp (TILE_SHEETS_4BPP: the credits logos, the VV
# emblem and the level-select cursor zoom) or 8bpp (TILE_SHEETS_8BPP: the
# level-select pictures, one per level theme), the manifest's `tiles`
# entries by their `bpp` (graphics_manifest.mk). The fonts and the VV
# letters and URL are OBJ sheets (below).
define TILE_SHEET_RULE
$(GRAPHICS_BUILDDIR)/$(1).img.bin: graphics/$(1).png | $(GRIT)
	@mkdir -p $$(dir $$@)
	$(GRIT) $$< -gt -gB$(2) -p! -ftb -fh! -o $(GRAPHICS_BUILDDIR)/$(1)
endef
$(foreach s,$(TILE_SHEETS_4BPP),$(eval $(call TILE_SHEET_RULE,$(s),4)))
$(foreach s,$(TILE_SHEETS_8BPP),$(eval $(call TILE_SHEET_RULE,$(s),8)))

# OBJ sheets (docs/graphics.md, "OBJ sheets"): tile sets made of whole
# OBJs (1D mapping, each OBJ's tiles back to back), drawn with each OBJ
# whole. tools/obj_sheet.py to-tiles puts their tiles back in the order the
# game uploads them, then grit converts that as it would the plain sheet.
# OBJ_SHEET_<sheet>: the layout (OBJ sizes in tile order, then a grid or
# each OBJ's position), and for the title's OBJ packages the width of
# their map (--width), which grit reduces like the other BG packages' maps.
OBJ_SHEET_TILE_SETS := fonts/small fonts/large logos/vicarious_visions/letters logos/vicarious_visions/url
OBJ_SHEET_PACKAGES := title/bandicoot title/crash \
	title/arrow2 title/arrow1
OBJ_SHEET_fonts/small := --obj 8x16*77 --obj 16x8*2 --columns 16 --cell 16x16
OBJ_SHEET_fonts/large := --obj 16x16*75 --columns 16
OBJ_SHEET_logos/vicarious_visions/letters := --obj 16x32*18 --columns 18
OBJ_SHEET_logos/vicarious_visions/url := --obj 32x16*4 --columns 4
OBJ_SHEET_title/bandicoot := --obj 32x16*3 --columns 3 --width 4
OBJ_SHEET_title/crash := --obj 64x64*5 --columns 5 --width 8
# The arrows: their four 32x32 OBJs at gTitleArrowPieceOffsets (title
# screen slot 0 draws arrow 2, slot 1 arrow 1).
OBJ_SHEET_title/arrow2 := --obj 32x32*4 --at 0,0 --at 15,32 --at 32,64 --at 49,96 --width 4
OBJ_SHEET_title/arrow1 := --obj 32x32*4 --at 61,0 --at 34,32 --at 5,61 --at 0,70 --width 4

define OBJ_SHEET_TILES_RULE
$(GRAPHICS_BUILDDIR)/$(1).img.bin: graphics/$(1).png tools/obj_sheet.py | $(GRIT)
	@mkdir -p $$(dir $$@)
	python3 tools/obj_sheet.py to-tiles $$< $(GRAPHICS_BUILDDIR)/$(1)_objs.png $(OBJ_SHEET_$(1))
	$(GRIT) $(GRAPHICS_BUILDDIR)/$(1)_objs.png -gt -gB4 -p! -ftb -fh! -o $(GRAPHICS_BUILDDIR)/$(1)
endef
define OBJ_SHEET_PACKAGE_RULE
$(GRAPHICS_BUILDDIR)/$(1)_grit.img.bin $(GRAPHICS_BUILDDIR)/$(1)_grit.map.bin &: graphics/$(1).png tools/obj_sheet.py | $(GRIT)
	@mkdir -p $$(dir $$@)
	python3 tools/obj_sheet.py to-tiles $$< $(GRAPHICS_BUILDDIR)/$(1)_objs.png $(OBJ_SHEET_$(1))
	$(GRIT) $(GRAPHICS_BUILDDIR)/$(1)_objs.png -gt -gB4 -p! -m -mLf -mRtf -ftb -fh! -o $(GRAPHICS_BUILDDIR)/$(1)_grit
endef
$(foreach s,$(OBJ_SHEET_TILE_SETS),$(eval $(call OBJ_SHEET_TILES_RULE,$(s))))
$(foreach s,$(OBJ_SHEET_PACKAGES),$(eval $(call OBJ_SHEET_PACKAGE_RULE,$(s))))

# The C bytes of an LZ77 stream, trimmed to the stream: gbagfx pads its
# output to 4 bytes, which the definitions' aligned(4) gives back where the
# ROM has it.
$(GRAPHICS_BUILDDIR)/%.lz.inc: $(GRAPHICS_BUILDDIR)/%.lz tools/bin2c.py
	python3 tools/bin2c.py $< $@ --lz

$(DATA_OBJS): CPPFLAGS += -iquote $(GRAPHICS_BUILDDIR)
# The 24 cutscene pictures (palette + Mode 4 bitmap each).
CUTSCENE_PICTURE_PNGS := $(wildcard graphics/cutscenes/*.png)
$(C_BUILDDIR)/game/ui/data/cutscene_pictures.o: $(patsubst graphics/%.png,$(GRAPHICS_BUILDDIR)/%.img.bin.lz.inc,$(CUTSCENE_PICTURE_PNGS)) \
	$(patsubst graphics/%.png,$(GRAPHICS_BUILDDIR)/%.pal.inc,$(CUTSCENE_PICTURE_PNGS))

# The two framed OBJ sprite sheets.
$(C_BUILDDIR)/game/vehicles/polar/data/polar_sprite_sheet.o: $(GRAPHICS_BUILDDIR)/vehicles/polar/sprite_sheet.bin.lz.inc
$(C_BUILDDIR)/game/vehicles/jetpack/data/jetpack_sprite_sheet.o: $(GRAPHICS_BUILDDIR)/vehicles/jetpack/sprite_sheet.bin.lz.inc

# The two HUD fonts (graphics/fonts/).
$(C_BUILDDIR)/engine/text/data/font_tiles.o: $(GRAPHICS_BUILDDIR)/fonts/small.img.bin.lz.inc $(GRAPHICS_BUILDDIR)/fonts/large.img.bin.lz.inc

# The menu, title and credits graphics (0x0861BADC-0x086377C0: the BG
# packages, below, and the credits and VV logo tile sheets) and the
# level-select cursor zoom, pictures and palettes (0x086377C0-0x0863D4C0)
# are graphics classes: graphics_manifest.mk gives their objects'
# prerequisites (see "The graphics classes" below).

# Actor-category backgrounds (docs/data.md, "Category backgrounds"): the
# BG0 cell animations (vehicles/polar/ice_wall, vehicles/jetpack/clouds) and
# the BG1 pictures (vehicles/jetpack/skies/). They are uncompressed, so
# grit's -ftb output goes straight into C initializers; tools/grit_bg.py
# only splits/interleaves it into the ROM's record layout. Every PNG is
# 8bpp indexed with the asset's 256-colour palette, each 8x8 cell drawn in
# one 16-colour bank (index = bank * 16 + 4bpp pixel), which grit's -mRtp
# map reduction turns back into the bank bits.

# Cell animation: all frames stacked in one tall PNG (row-major tiles, so
# the tile stream is the frames back to back), plus the 256-colour palette,
# and, for $(3) = banks, its per-cell palette banks: only the bank bits of
# that map are used (its tile indices are a reduced set and are ignored).
# $(2) is the number of cells in a frame.
define CELL_ANIM_RULE
$(GRAPHICS_BUILDDIR)/$(1).img.bin $(GRAPHICS_BUILDDIR)/$(1).pal.bin &: graphics/$(1).png | $(GRIT)
	@mkdir -p $$(dir $$@)
	$(GRIT) $$< -gt -gB4 -p -pn256 -ftb -fh! -o $(GRAPHICS_BUILDDIR)/$(1)
$(GRAPHICS_BUILDDIR)/$(1)_banks.map.bin: graphics/$(1).png | $(GRIT)
	@mkdir -p $$(dir $$@)
	$(GRIT) $$< -gt -gB4 -p! -m -mRtp -mLf -ftb -fh! -o $(GRAPHICS_BUILDDIR)/$(1)_banks
$(GRAPHICS_BUILDDIR)/$(1)_frames.inc: $(GRAPHICS_BUILDDIR)/$(1).img.bin $(if $(3),$(GRAPHICS_BUILDDIR)/$(1)_banks.map.bin) tools/grit_bg.py
	python3 tools/grit_bg.py frames $$< $$@ --cells $(2) $(if $(3),--banks $(GRAPHICS_BUILDDIR)/$(1)_banks.map.bin)
$(GRAPHICS_BUILDDIR)/$(1).pal.inc: $(GRAPHICS_BUILDDIR)/$(1).pal.bin tools/bin2c.py
	python3 tools/bin2c.py $$< $$@ --u16
endef
$(eval $(call CELL_ANIM_RULE,vehicles/polar/ice_wall,247,banks))
$(eval $(call CELL_ANIM_RULE,vehicles/jetpack/clouds,380,))

# BG1 picture: the tile set is its own 8px-wide strip PNG (<picture>_tiles,
# grit's external tileset, -fx, so the map indices are the ROM's), the
# picture PNG gives the palette and, reduced against that tile set, the map.
# grit doesn't only read the -fx tile set, it also writes it back when it
# exits. Pointing -fx at graphics/ rewrote a source PNG while the tile
# set's rule could be reading it, so a parallel clean build sometimes
# failed with "grit: can't read '..._tiles.png'". The map rule therefore
# works on a private copy under build/.
define BG_PICTURE_RULE
$(GRAPHICS_BUILDDIR)/$(1).pal.bin: graphics/$(1).png | $(GRIT)
	@mkdir -p $$(dir $$@)
	$(GRIT) $$< -g! -p -pn256 -ftb -fh! -o $(GRAPHICS_BUILDDIR)/$(1)
$(GRAPHICS_BUILDDIR)/$(1)_tiles.img.bin: graphics/$(1)_tiles.png | $(GRIT)
	@mkdir -p $$(dir $$@)
	$(GRIT) $$< -gt -gB4 -p! -ftb -fh! -o $(GRAPHICS_BUILDDIR)/$(1)_tiles
$(GRAPHICS_BUILDDIR)/$(1)_map.map.bin: graphics/$(1).png graphics/$(1)_tiles.png | $(GRIT)
	@mkdir -p $$(dir $$@)
	cp $$(word 2,$$^) $(GRAPHICS_BUILDDIR)/$(1)_map_fx.png
	$(GRIT) $$< -gt -gB4 -p! -m -mRtp -mLf -fx $(GRAPHICS_BUILDDIR)/$(1)_map_fx.png -ftb -fh! -o $(GRAPHICS_BUILDDIR)/$(1)_map
$(GRAPHICS_BUILDDIR)/$(1)_map.inc: $(GRAPHICS_BUILDDIR)/$(1)_map.map.bin tools/grit_bg.py
	python3 tools/grit_bg.py map $$< $$@
$(GRAPHICS_BUILDDIR)/$(1)_banks.inc: $(GRAPHICS_BUILDDIR)/$(1)_map.map.bin tools/grit_bg.py
	python3 tools/grit_bg.py banks $$< $$@
$(GRAPHICS_BUILDDIR)/$(1).pal.inc: $(GRAPHICS_BUILDDIR)/$(1).pal.bin tools/bin2c.py
	python3 tools/bin2c.py $$< $$@ --u16
$(GRAPHICS_BUILDDIR)/$(1)_tiles.img.inc: $(GRAPHICS_BUILDDIR)/$(1)_tiles.img.bin tools/bin2c.py
	python3 tools/bin2c.py $$< $$@
endef
SKIES := $(addprefix vehicles/jetpack/skies/,rocket_racket blimp_bonanza no_fly_zone)
$(foreach p,$(SKIES),$(eval $(call BG_PICTURE_RULE,$(p))))

bg_picture_incs = $(foreach p,$(1),$(GRAPHICS_BUILDDIR)/$(p).pal.inc $(GRAPHICS_BUILDDIR)/$(p)_tiles.img.inc \
	$(GRAPHICS_BUILDDIR)/$(p)_map.inc $(GRAPHICS_BUILDDIR)/$(p)_banks.inc)
$(C_BUILDDIR)/game/vehicles/polar/data/polar_cell_anim.o: $(GRAPHICS_BUILDDIR)/vehicles/polar/ice_wall.pal.inc \
	$(GRAPHICS_BUILDDIR)/vehicles/polar/ice_wall_frames.inc
$(C_BUILDDIR)/game/vehicles/jetpack/data/jetpack_cell_anim.o: $(GRAPHICS_BUILDDIR)/vehicles/jetpack/clouds.pal.inc \
	$(GRAPHICS_BUILDDIR)/vehicles/jetpack/clouds_frames.inc $(call bg_picture_incs,vehicles/jetpack/skies/rocket_racket)
$(C_BUILDDIR)/game/vehicles/jetpack/data/jetpack_sky_pictures.o: $(call bg_picture_incs,vehicles/jetpack/skies/blimp_bonanza vehicles/jetpack/skies/no_fly_zone)

# The struct bg_package pictures (docs/graphics.md "Menu and title
# pictures"): the menu backgrounds (graphics/menus/), the title screen's
# logo and OBJ sprites (graphics/title/), the Universal logo
# (graphics/logos/) and the level-select platform (graphics/level_select/).
# The tile set and map of
# each are rebuilt from one PNG of the whole picture. grit reduces the
# picture to tiles + map, and tools/bg_map.py first-use puts the tiles in
# the ROM's order (order of first use; grit starts with a forced blank
# tile). gbagfx compresses, and src/game/ui/data/menu_graphics.cpp holds the
# results. Each package's palette is its PNG's palette. The packages
# (BG_PACKAGES) and their bpp (BG_PACKAGE_BPP_<package>) are the manifest's
# bg_package entries (graphics_manifest.mk).
# Tile reduction: tiles and flips, except for the affine maps (no flips,
# BG_PACKAGES_AFFINE): the title and the universal logo.
BG_PACKAGE_REDUCE = $(if $(filter $(BG_PACKAGES_AFFINE),$(1)),-mRt,-mRtf)
# The universal logo's affine map has 5 entries with a stray high byte,
# which nothing reads (bg_map.py first-use --high puts them back).
BG_PACKAGE_HIGH_logos/universal := graphics/logos/universal_high.json

# $(1): the package. The title's OBJ packages get their grit output from
# OBJ_SHEET_PACKAGE_RULE (above).
define BG_PACKAGE_GRIT_RULE
$(GRAPHICS_BUILDDIR)/$(1)_grit.img.bin $(GRAPHICS_BUILDDIR)/$(1)_grit.map.bin &: graphics/$(1).png | $(GRIT)
	@mkdir -p $$(dir $$@)
	$(GRIT) $$< -gt -gB$(BG_PACKAGE_BPP_$(1)) -p! -m -mLf $(call BG_PACKAGE_REDUCE,$(1)) -ftb -fh! -o $(GRAPHICS_BUILDDIR)/$(1)_grit
endef
define BG_PACKAGE_RULE
$(GRAPHICS_BUILDDIR)/$(1).img.bin $(GRAPHICS_BUILDDIR)/$(1).map.bin &: $(GRAPHICS_BUILDDIR)/$(1)_grit.img.bin $(GRAPHICS_BUILDDIR)/$(1)_grit.map.bin tools/bg_map.py $(BG_PACKAGE_HIGH_$(1))
	python3 tools/bg_map.py first-use $$(word 1,$$^) $$(word 2,$$^) $(GRAPHICS_BUILDDIR)/$(1).img.bin $(GRAPHICS_BUILDDIR)/$(1).map.bin --bpp $(BG_PACKAGE_BPP_$(1)) $(addprefix --high ,$(BG_PACKAGE_HIGH_$(1)))
endef
$(foreach p,$(filter-out $(OBJ_SHEET_PACKAGES),$(BG_PACKAGES)),$(eval $(call BG_PACKAGE_GRIT_RULE,$(p))))
$(foreach p,$(BG_PACKAGES),$(eval $(call BG_PACKAGE_RULE,$(p))))

# The sprite banks (graphics/sprites/bankNN_<name>/, docs/graphics.md
# "Sprite banks"): a PNG per frame and bank.json per bank.
# tools/sprite_frames.py pack cuts the frames into the tile pool, one
# tiles .inc per bank, generates the frames' piece arrays (a pieces .inc
# per bank) and sprite_frames.h with each frame's tile offset. One run for
# all banks, since a bank's offset depends on every earlier bank's size.
SPRITE_BANK_DIRS := $(sort $(wildcard graphics/sprites/bank[0-9][0-9]_*))
SPRITE_FRAME_SOURCES := $(foreach d,$(SPRITE_BANK_DIRS),$(d)/bank.json $(wildcard $(d)/f*.png))
SPRITE_FRAMES_DIR := $(GRAPHICS_BUILDDIR)/sprites
SPRITE_FRAMES_OUT := $(SPRITE_FRAMES_DIR)/sprite_frames.h \
	$(foreach d,$(SPRITE_BANK_DIRS),$(SPRITE_FRAMES_DIR)/$(word 1,$(subst _, ,$(notdir $(d))))_tiles.inc \
	$(SPRITE_FRAMES_DIR)/$(word 1,$(subst _, ,$(notdir $(d))))_pieces.inc)
$(SPRITE_FRAMES_OUT) &: $(SPRITE_FRAME_SOURCES) tools/sprite_frames.py
	python3 tools/sprite_frames.py pack $(SPRITE_FRAMES_DIR)

$(C_BUILDDIR)/engine/gfx/data/sprite_tiles.o $(foreach f,00_09 10_21 22_38 39_55,$(call data_obj,sprite_banks_$(f))): $(SPRITE_FRAMES_OUT)

# The 125 OBJ palettes (gObjPalettes): one JASC file per paletteId,
# graphics/sprites/palettes/NNN_<owner>.pal (NNN the paletteId, <owner>
# the first sprite bank whose animations use it, or `unused`), back to
# back in index order.
OBJ_PALETTE_PALS := $(sort $(wildcard graphics/sprites/palettes/*.pal))
$(GRAPHICS_BUILDDIR)/sprites/obj_palettes.bin: $(patsubst graphics/%.pal,$(GRAPHICS_BUILDDIR)/%.gbapal,$(OBJ_PALETTE_PALS))
	@mkdir -p $(dir $@)
	cat $^ > $@
$(GRAPHICS_BUILDDIR)/sprites/obj_palettes.bin.inc: $(GRAPHICS_BUILDDIR)/sprites/obj_palettes.bin tools/bin2c.py
	python3 tools/bin2c.py $< $@
$(C_BUILDDIR)/engine/gfx/data/sprite_tiles.o: $(GRAPHICS_BUILDDIR)/sprites/obj_palettes.bin.inc

# The two boss pictures (docs/data.md "Boss pictures"): the airship
# (graphics/vehicles/jetpack/airship/frameN.png, 4 frames) and N. Gin's
# hovercraft (graphics/bosses/hovercraft.png, 1 frame). grit turns each
# frame into 4bpp tiles in cell order, and tools/boss_pictures.py
# deduplicates them into the ROM's shared tile pool and per-frame maps.
AIRSHIP_FRAMES := $(addprefix vehicles/jetpack/airship/frame,0 1 2 3)
BOSS_PICTURE_FRAMES := $(AIRSHIP_FRAMES) bosses/hovercraft
$(patsubst %,$(GRAPHICS_BUILDDIR)/%.img.bin,$(BOSS_PICTURE_FRAMES)): $(GRAPHICS_BUILDDIR)/%.img.bin: graphics/%.png | $(GRIT)
	@mkdir -p $(dir $@)
	$(GRIT) $< -gt -gB4 -p! -ftb -fh! -o $(@:.img.bin=)

# $(1): the picture's built name, $(2): its frames, $(3): its macro prefix,
# $(4): its width in cells.
define BOSS_PICTURE_RULE
$(GRAPHICS_BUILDDIR)/$(1).inc $(GRAPHICS_BUILDDIR)/$(1).h &: tools/boss_pictures.py $(patsubst %,$(GRAPHICS_BUILDDIR)/%.img.bin,$(2))
	@mkdir -p $$(dir $$@)
	python3 tools/boss_pictures.py pack $(GRAPHICS_BUILDDIR)/$(1).inc $(GRAPHICS_BUILDDIR)/$(1).h --name $(3) --cols $(4) $(patsubst %,$(GRAPHICS_BUILDDIR)/%.img.bin,$(2))
endef
$(eval $(call BOSS_PICTURE_RULE,vehicles/jetpack/airship,$(AIRSHIP_FRAMES),AIRSHIP_PICTURE,18))
$(eval $(call BOSS_PICTURE_RULE,bosses/hovercraft,bosses/hovercraft,HOVERCRAFT_PICTURE,16))

$(C_BUILDDIR)/game/bosses/data/boss_pictures.o: $(foreach p,vehicles/jetpack/airship bosses/hovercraft,$(GRAPHICS_BUILDDIR)/$(p).inc $(GRAPHICS_BUILDDIR)/$(p).h)
# Zero-run-compressed OBJ frame sets (the old "rotation strips", see
# docs/data.md "Compressed sprite frames"): one PNG per set, the frames
# stacked top to bottom: the polar player and the Yeti
# (graphics/vehicles/polar/player.png, yeti.png) and the jetpack player
# (graphics/vehicles/jetpack/player.png). grit does the 4bpp layout,
# tools/rle_sprites.py compresses each frame the way the ROM's encoder did
# and writes the bytes plus a header of frame offsets (for the frame
# pointer tables), RLE_SPRITES_<name>_FRAME_nnn.
# $(1): the set, $(2): its frame size in tiles, $(3): its macro name.
define RLE_SPRITE_RULE
$(GRAPHICS_BUILDDIR)/$(1).img.bin: graphics/$(1).png | $(GRIT)
	@mkdir -p $$(dir $$@)
	$(GRIT) $$< -gt -gB4 -p! -ftb -fh! -o $(GRAPHICS_BUILDDIR)/$(1)
$(GRAPHICS_BUILDDIR)/$(1).inc $(GRAPHICS_BUILDDIR)/$(1).h &: $(GRAPHICS_BUILDDIR)/$(1).img.bin tools/rle_sprites.py
	python3 tools/rle_sprites.py pack $$< $(GRAPHICS_BUILDDIR)/$(1).inc $(GRAPHICS_BUILDDIR)/$(1).h --frame $(2) --name RLE_SPRITES_$(3)
endef
$(eval $(call RLE_SPRITE_RULE,vehicles/polar/player,8x8,POLAR_PLAYER))
$(eval $(call RLE_SPRITE_RULE,vehicles/polar/yeti,10x10,YETI))
$(eval $(call RLE_SPRITE_RULE,vehicles/jetpack/player,8x8,JETPACK_PLAYER))

rle_sprite_files = $(foreach s,$(1),$(GRAPHICS_BUILDDIR)/$(s).inc $(GRAPHICS_BUILDDIR)/$(s).h)
$(C_BUILDDIR)/game/vehicles/polar/data/polar_rle_sprites.o: $(call rle_sprite_files,vehicles/polar/player vehicles/polar/yeti)
$(C_BUILDDIR)/game/vehicles/jetpack/data/jetpack_rle_sprites.o: $(call rle_sprite_files,vehicles/jetpack/player)
$(C_BUILDDIR)/game/vehicles/polar/data/yeti_frames.o: $(call rle_sprite_files,vehicles/polar/yeti)
$(C_BUILDDIR)/game/vehicles/polar/data/polar_anim_family.o: $(call rle_sprite_files,vehicles/polar/player) $(GRAPHICS_BUILDDIR)/vehicles/polar/sprite_sheet_frames.h
$(C_BUILDDIR)/game/vehicles/jetpack/data/jetpack_anim_family.o: $(call rle_sprite_files,vehicles/jetpack/player) $(GRAPHICS_BUILDDIR)/vehicles/jetpack/sprite_sheet_frames.h

# The graphics classes (docs/graphics.md, "Graphics classes"): a graphic of
# graphics/manifest.json with a `class` is that class, its parts static const
# data members. graphics.hpp declares them all (written only if it changed,
# behind a stamp, so a manifest edit that keeps it rebuilds nothing). Each
# object of the manifest's `objects` (GRAPHICS_CLASS_OBJECTS) #includes the
# definitions of the members in its ROM range, in ROM order, then those of
# the new graphics that name it, from <object>.inc, and depends on their
# bytes (graphics_manifest.mk).
GRAPHICS_CLASSES_HEADER := $(GENERATED_INCLUDE_DIR)/graphics.hpp
GENERATED_HEADERS += $(GRAPHICS_CLASSES_HEADER)
$(GRAPHICS_CLASSES_HEADER).stamp: graphics/manifest.json tools/gfx_manifest.py
	@mkdir -p $(dir $@)
	python3 tools/gfx_manifest.py header $(GRAPHICS_CLASSES_HEADER)
	@touch $@
$(GRAPHICS_CLASSES_HEADER): $(GRAPHICS_CLASSES_HEADER).stamp
	@test -f $@ || python3 tools/gfx_manifest.py header $@

define GRAPHICS_DEFS_RULE
$(GRAPHICS_BUILDDIR)/$(1).inc: graphics/manifest.json tools/gfx_manifest.py
	python3 tools/gfx_manifest.py defs $(1) $$@
$(call data_obj,$(1)): $(GRAPHICS_BUILDDIR)/$(1).inc
endef
$(foreach o,$(GRAPHICS_CLASS_OBJECTS),$(eval $(call GRAPHICS_DEFS_RULE,$(o))))
