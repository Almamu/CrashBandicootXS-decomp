
# The graphics rules every game's build shares (#1115): the ones the
# manifest drives. graphics.mk includes them for XS, after the XS lists
# they read (OBJ_SHEET_PACKAGES, BG_PACKAGE_HIGH_<package>), and
# games/n2/graphics.mk for N-Tranced.
#
# All rules below take a source under GRAPHICS_DIR (the game's: XS's
# graphics/, N-Tranced's games/n2/graphics/) and produce the
# corresponding built file under $(GRAPHICS_BUILDDIR), mirroring the
# subdirectory layout, so GRAPHICS_DIR only ever holds editable sources.
# A source the game's directory doesn't have is XS's (gfx_src): a graphic
# both games have is only in graphics/ (docs/n_tranced.md, "Graphics").
# Every asset ends up as C initializer bytes (tools/bin2c.py) that a
# data table's definition #includes (docs/data.md, "Resources");
# data/data.s incbins no graphics.
GRAPHICS_DIR ?= graphics
gfx_src = $(firstword $(wildcard $(GRAPHICS_DIR)/$(1)) graphics/$(1))
# gfx_manifest.py on the game's graphics (XS's is its default)
GFX_MANIFEST := python3 tools/gfx_manifest.py$(if $(filter-out graphics,$(GRAPHICS_DIR)), --graphics-dir $(GRAPHICS_DIR))

# The lists that follow the game's manifest.json (docs/graphics.md, "The
# manifest"): the tile sheets and BG packages with their bpp, the 16-colour
# PNG palettes, the graphics class objects and each one's prerequisites.
# Generated by tools/gfx_manifest.py make, so a new graphic (an entry with
# no ROM address) gets its rules from its entry.
GRAPHICS_MANIFEST_MK := $(GRAPHICS_BUILDDIR)/graphics_manifest.mk
$(GRAPHICS_MANIFEST_MK): $(GRAPHICS_DIR)/manifest.json tools/gfx_manifest.py
	$(GFX_MANIFEST) make $@
include $(GRAPHICS_MANIFEST_MK)

# Palettes -> raw GBA .gbapal. Read as gbagfx reads them, plus the ROM's
# stray bit-15 entries, which tools/jasc_pal.py keeps in the red value's
# lowest bit (docs/graphics.md, "Palettes"). A standalone palette is JASC
# .pal text (the OBJ palettes, graphics/sprites/palettes/); a palette that
# belongs to one picture is that picture's PNG palette, which must have
# exactly the colours its manifest entry gives: 256, or 16 for the pictures
# in PALETTE_COLORS_16 (graphics_manifest.mk; png-to-gba --colors fails
# otherwise, so an editor that pads or trims the palette is caught).
$(GRAPHICS_BUILDDIR)/%.gbapal: $(GRAPHICS_DIR)/%.pal tools/jasc_pal.py
	@mkdir -p $(dir $@)
	python3 tools/jasc_pal.py to-gba $< $@
$(GRAPHICS_BUILDDIR)/%.gbapal: $(GRAPHICS_DIR)/%.png tools/jasc_pal.py
	@mkdir -p $(dir $@)
	python3 tools/jasc_pal.py png-to-gba $< $@ --colors $(if $(filter $*,$(PALETTE_COLORS_16)),16,256)
ifneq ($(GRAPHICS_DIR),graphics)
# XS's, for what the game's directory doesn't have
$(GRAPHICS_BUILDDIR)/%.gbapal: graphics/%.pal tools/jasc_pal.py
	@mkdir -p $(dir $@)
	python3 tools/jasc_pal.py to-gba $< $@
$(GRAPHICS_BUILDDIR)/%.gbapal: graphics/%.png tools/jasc_pal.py
	@mkdir -p $(dir $@)
	python3 tools/jasc_pal.py png-to-gba $< $@ --colors $(if $(filter $*,$(PALETTE_COLORS_16)),16,256)
endif

# The framed OBJ sprite sheets of the actor categories (the polar and
# jetpack families' graphics/vehicles/<family>/sprite_sheet/, and any new
# one a category names, docs/levels.md "Category sprite sheets"): each
# subdirectory is one
# distinct entity (one animation's worth of frame data - see
# docs/graphics.md, "Re-splitting into one file per entity"), containing
# one indexed PNG per frame, named so filename sort order matches original
# ROM frame order, with no sidecar metadata - a frame's own tile dimensions
# are just its PNG size / 8. gbagfx can't be used directly: each frame has
# a 4-byte non-pixel header not present in a plain PNG<->4bpp round trip.
# Explicit (non-pattern) rules, one per entity folder, so
# editing/adding/removing a frame PNG is tracked like any other
# prerequisite. The sheet's sheet.json lists the entities in the sheet's
# order (FRAMED_ENTITIES_<sheet>, tools/framed_gfx.py order). The sheets
# are the manifest's framed_sheet entries, by their directory under
# GRAPHICS_DIR (FRAMED_SHEETS, with each one's FRAMED_NAME_<sheet>,
# graphics_manifest.mk).
$(foreach s,$(FRAMED_SHEETS),$(eval FRAMED_ENTITIES_$(s) := $(shell python3 tools/framed_gfx.py order $(call gfx_src,$(s)))))

define FRAMED_ENTITY_RULE
$(GRAPHICS_BUILDDIR)/$(1)/$(2).bin: $$(sort $$(wildcard $(call gfx_src,$(1)/$(2))/*.png)) tools/framed_gfx.py
	@mkdir -p $$(dir $$@)
	python3 tools/framed_gfx.py to-bin-folder $(call gfx_src,$(1)/$(2)) $$@ $(FRAMED_TO_BIN_FLAGS)
endef

# Split multi-record sprite sheets: each ROM asset below was originally one
# big LZ77 stream, so it must be recompressed as a single unit - every
# entity's converted bytes get concatenated back in the order of the
# sheet's sheet.json before compression.
define FRAMED_SHEET_RULE
$(GRAPHICS_BUILDDIR)/$(1).bin: $(foreach e,$(FRAMED_ENTITIES_$(1)),$(GRAPHICS_BUILDDIR)/$(1)/$(e).bin) $(call gfx_src,$(1)/sheet.json)
	@mkdir -p $$(dir $$@)
	cat $$(filter %.bin,$$^) > $$@
endef

# The byte offset of every frame in a sheet (FRAMED_<NAME>_<ENTITY>_<NN>),
# for the animation tables' pool_offset table_B arrays (data/levels/anim_tables/,
# which levels.mk generates into polar_anim_family.cpp and jetpack_anim_family.cpp,
# and a new one into actor_categories.cpp).
define FRAMED_HEADER_RULE
$(GRAPHICS_BUILDDIR)/$(1)_frames.h: $(sort $(wildcard $(call gfx_src,$(1))/*/*.png)) $(call gfx_src,$(1)/sheet.json) tools/framed_gfx.py
	@mkdir -p $$(dir $$@)
	python3 tools/framed_gfx.py header $(call gfx_src,$(1)) $$@ --name $(FRAMED_NAME_$(1))
endef

$(foreach sheet,$(FRAMED_SHEETS),\
  $(foreach entity,$(FRAMED_ENTITIES_$(sheet)),\
    $(eval $(call FRAMED_ENTITY_RULE,$(sheet),$(entity)))))
$(foreach sheet,$(FRAMED_SHEETS),$(eval $(call FRAMED_SHEET_RULE,$(sheet))))
$(foreach sheet,$(FRAMED_SHEETS),$(eval $(call FRAMED_HEADER_RULE,$(sheet))))

# Generic LZ77 compression, used for every asset type above. A built file
# in GFX_LZ_SEARCH1 is compressed with -search 1 (no VRAM-safe minimum
# match distance): N-Tranced packed some of its assets that way.
$(GRAPHICS_BUILDDIR)/%.lz: $(GRAPHICS_BUILDDIR)/% | $(GFX)
	@mkdir -p $(dir $@)
	$(GFX) $< $@$(if $(filter $*,$(GFX_LZ_SEARCH1)), -search 1)

# PNG -> C const array (grit), see docs/graphics.md. grit does the pixel
# layout, gbagfx the byte-exact LZ77 (grit's own -gzl compressor does not
# reproduce the ROM's streams), tools/bin2c.py the initializer bytes that a
# data table's file #includes.

# Tile sheets: grit -gt, 4bpp (TILE_SHEETS_4BPP: the credits logos, the VV
# emblem and the level-select cursor zoom) or 8bpp (TILE_SHEETS_8BPP: the
# level-select pictures, one per level theme), the manifest's `tiles`
# entries by their `bpp` (graphics_manifest.mk). The fonts and the VV
# letters and URL are OBJ sheets (graphics.mk).
define TILE_SHEET_RULE
$(GRAPHICS_BUILDDIR)/$(1).img.bin: $(call gfx_src,$(1).png) | $(GRIT)
	@mkdir -p $$(dir $$@)
	$(GRIT) $$< -gt -gB$(2) -p! -ftb -fh! -o $(GRAPHICS_BUILDDIR)/$(1)
endef
$(foreach s,$(TILE_SHEETS_4BPP),$(eval $(call TILE_SHEET_RULE,$(s),4)))
$(foreach s,$(TILE_SHEETS_8BPP),$(eval $(call TILE_SHEET_RULE,$(s),8)))

# The C bytes of an LZ77 stream, trimmed to the stream: gbagfx pads its
# output to 4 bytes, which the definitions' aligned(4) gives back where the
# ROM has it.
$(GRAPHICS_BUILDDIR)/%.lz.inc: $(GRAPHICS_BUILDDIR)/%.lz tools/bin2c.py
	python3 tools/bin2c.py $< $@ --lz

# Actor-category backgrounds (docs/data.md, "Category backgrounds"): the
# BG0 cell animations (vehicles/polar/ice_wall, vehicles/jetpack/clouds) and
# the BG1 pictures (vehicles/jetpack/skies/). They are uncompressed, so
# grit's -ftb output goes straight into C initializers; tools/grit_bg.py
# only splits/interleaves it into the ROM's record layout. Every PNG is
# 8bpp indexed with the asset's 256-colour palette, each 8x8 cell drawn in
# one 16-colour bank (index = bank * 16 + 4bpp pixel), which grit's -mRtp
# map reduction turns back into the bank bits.

# Cell animation: all frames stacked in one tall PNG (row-major tiles, so
# the tile stream is the frames back to back), plus the 256-colour palette,
# and, for $(3) = banks, its per-cell palette banks: only the bank bits of
# that map are used (its tile indices are a reduced set and are ignored).
# $(2) is the number of frames.
define CELL_ANIM_RULE
$(GRAPHICS_BUILDDIR)/$(1).img.bin $(GRAPHICS_BUILDDIR)/$(1).pal.bin &: $(call gfx_src,$(1).png) | $(GRIT)
	@mkdir -p $$(dir $$@)
	$(GRIT) $$< -gt -gB4 -p -pn256 -ftb -fh! -o $(GRAPHICS_BUILDDIR)/$(1)
$(GRAPHICS_BUILDDIR)/$(1)_banks.map.bin: $(call gfx_src,$(1).png) | $(GRIT)
	@mkdir -p $$(dir $$@)
	$(GRIT) $$< -gt -gB4 -p! -m -mRtp -mLf -ftb -fh! -o $(GRAPHICS_BUILDDIR)/$(1)_banks
$(GRAPHICS_BUILDDIR)/$(1)_frames.inc: $(GRAPHICS_BUILDDIR)/$(1).img.bin $(if $(3),$(GRAPHICS_BUILDDIR)/$(1)_banks.map.bin) tools/grit_bg.py
	python3 tools/grit_bg.py frames $$< $$@ --frames $(2) $(if $(3),--banks $(GRAPHICS_BUILDDIR)/$(1)_banks.map.bin)
$(GRAPHICS_BUILDDIR)/$(1).pal.inc: $(GRAPHICS_BUILDDIR)/$(1).pal.bin tools/bin2c.py
	python3 tools/bin2c.py $$< $$@ --u16
endef
# The cell animations (CELL_ANIMS) with their frame counts and banks are
# the manifest's cell_anim entries (graphics_manifest.mk).
$(foreach a,$(CELL_ANIMS),$(eval $(call CELL_ANIM_RULE,$(a),$(CELL_ANIM_FRAMES_$(a)),$(CELL_ANIM_BANKS_$(a)))))

# BG1 picture: the tile set is its own 8px-wide strip PNG (<picture>_tiles,
# grit's external tileset, -fx, so the map indices are the ROM's), the
# picture PNG gives the palette and, reduced against that tile set, the map.
# grit doesn't only read the -fx tile set, it also writes it back when it
# exits. Pointing -fx at graphics/ rewrote a source PNG while the tile
# set's rule could be reading it, so a parallel clean build sometimes
# failed with "grit: can't read '..._tiles.png'". The map rule therefore
# works on a private copy under build/.
define BG_PICTURE_RULE
$(GRAPHICS_BUILDDIR)/$(1).pal.bin: $(call gfx_src,$(1).png) | $(GRIT)
	@mkdir -p $$(dir $$@)
	$(GRIT) $$< -g! -p -pn256 -ftb -fh! -o $(GRAPHICS_BUILDDIR)/$(1)
$(GRAPHICS_BUILDDIR)/$(1)_tiles.img.bin: $(call gfx_src,$(1)_tiles.png) | $(GRIT)
	@mkdir -p $$(dir $$@)
	$(GRIT) $$< -gt -gB4 -p! -ftb -fh! -o $(GRAPHICS_BUILDDIR)/$(1)_tiles
$(GRAPHICS_BUILDDIR)/$(1)_map.map.bin: $(call gfx_src,$(1).png) $(call gfx_src,$(1)_tiles.png) | $(GRIT)
	@mkdir -p $$(dir $$@)
	cp $$(word 2,$$^) $(GRAPHICS_BUILDDIR)/$(1)_map_fx.png
	$(GRIT) $$< -gt -gB4 -p! -m -mRtp -mLf -fx $(GRAPHICS_BUILDDIR)/$(1)_map_fx.png -ftb -fh! -o $(GRAPHICS_BUILDDIR)/$(1)_map
$(GRAPHICS_BUILDDIR)/$(1)_map.inc: $(GRAPHICS_BUILDDIR)/$(1)_map.map.bin tools/grit_bg.py
	python3 tools/grit_bg.py map $$< $$@
$(GRAPHICS_BUILDDIR)/$(1)_banks.inc: $(GRAPHICS_BUILDDIR)/$(1)_map.map.bin tools/grit_bg.py
	python3 tools/grit_bg.py banks $$< $$@
$(GRAPHICS_BUILDDIR)/$(1).pal.inc: $(GRAPHICS_BUILDDIR)/$(1).pal.bin tools/bin2c.py
	python3 tools/bin2c.py $$< $$@ --u16
$(GRAPHICS_BUILDDIR)/$(1)_tiles.img.inc: $(GRAPHICS_BUILDDIR)/$(1)_tiles.img.bin tools/bin2c.py
	python3 tools/bin2c.py $$< $$@
endef
# The BG1 pictures (BG_PICTURES) are the manifest's bg_picture entries.
$(foreach p,$(BG_PICTURES),$(eval $(call BG_PICTURE_RULE,$(p))))
bg_picture_incs = $(foreach p,$(1),$(GRAPHICS_BUILDDIR)/$(p).pal.inc $(GRAPHICS_BUILDDIR)/$(p)_tiles.img.inc \
	$(GRAPHICS_BUILDDIR)/$(p)_map.inc $(GRAPHICS_BUILDDIR)/$(p)_banks.inc)

# A new category's OBJ palette (CATEGORY_PALETTES, the manifest's
# category_palette entries): a JASC .pal of 256 colours, an uncompressed
# u16 array (docs/levels.md, "Category graphics").
define CATEGORY_PALETTE_RULE
$(GRAPHICS_BUILDDIR)/$(1).gbapal.inc: $(GRAPHICS_BUILDDIR)/$(1).gbapal tools/bin2c.py
	python3 tools/bin2c.py $$< $$@ --u16
endef
$(foreach p,$(CATEGORY_PALETTES),$(eval $(call CATEGORY_PALETTE_RULE,$(p))))

# A polar category's BG palette cycle (PALETTE_CYCLES, the manifest's
# palette_cycle entries, ActorPaletteCycle::frames and a category's own):
# a directory of 32 JASC .pal files of BG palettes 0-13
# (PALETTE_CYCLE_FRAMES_<cycle>), back to back, a u16 [32][224] initializer
# with a row per frame (docs/levels.md, "Category graphics").
define PALETTE_CYCLE_RULE
$(GRAPHICS_BUILDDIR)/$(1).bin: $(patsubst $(GRAPHICS_DIR)/%.pal,$(GRAPHICS_BUILDDIR)/%.gbapal,$(PALETTE_CYCLE_FRAMES_$(1)))
	@mkdir -p $$(dir $$@)
	cat $$^ > $$@
$(GRAPHICS_BUILDDIR)/$(1).bin.inc: $(GRAPHICS_BUILDDIR)/$(1).bin tools/bin2c.py
	python3 tools/bin2c.py $$< $$@ --u16 --rows 224
endef
$(foreach p,$(PALETTE_CYCLES),$(eval $(call PALETTE_CYCLE_RULE,$(p))))

# The struct bg_package pictures (docs/graphics.md "Menu and title
# pictures"): the menu backgrounds (graphics/menus/), the title screen's
# logo and OBJ sprites (graphics/title/), the Universal logo
# (graphics/logos/) and the level-select platform (graphics/level_select/).
# The tile set and map of
# each are rebuilt from one PNG of the whole picture. grit reduces the
# picture to tiles + map, and tools/bg_map.py first-use puts the tiles in
# the ROM's order (order of first use; grit starts with a forced blank
# tile). gbagfx compresses, and src/game/ui/data/menu_graphics.cpp holds the
# results. Each package's palette is its PNG's palette. The packages
# (BG_PACKAGES) and their bpp (BG_PACKAGE_BPP_<package>) are the manifest's
# bg_package entries (graphics_manifest.mk).
# Tile reduction: tiles and flips, except for the affine maps (no flips,
# BG_PACKAGES_AFFINE): the title and the universal logo.
BG_PACKAGE_REDUCE = $(if $(filter $(BG_PACKAGES_AFFINE),$(1)),-mRt,-mRtf)

# $(1): the package. The title's OBJ packages get their grit output from
# OBJ_SHEET_PACKAGE_RULE (graphics.mk).
define BG_PACKAGE_GRIT_RULE
$(GRAPHICS_BUILDDIR)/$(1)_grit.img.bin $(GRAPHICS_BUILDDIR)/$(1)_grit.map.bin &: $(call gfx_src,$(1).png) | $(GRIT)
	@mkdir -p $$(dir $$@)
	$(GRIT) $$< -gt -gB$(BG_PACKAGE_BPP_$(1)) -p! -m -mLf $(call BG_PACKAGE_REDUCE,$(1)) -ftb -fh! -o $(GRAPHICS_BUILDDIR)/$(1)_grit
endef
define BG_PACKAGE_RULE
$(GRAPHICS_BUILDDIR)/$(1).img.bin $(GRAPHICS_BUILDDIR)/$(1).map.bin &: $(GRAPHICS_BUILDDIR)/$(1)_grit.img.bin $(GRAPHICS_BUILDDIR)/$(1)_grit.map.bin tools/bg_map.py $(BG_PACKAGE_HIGH_$(1))
	python3 tools/bg_map.py first-use $$(word 1,$$^) $$(word 2,$$^) $(GRAPHICS_BUILDDIR)/$(1).img.bin $(GRAPHICS_BUILDDIR)/$(1).map.bin --bpp $(BG_PACKAGE_BPP_$(1)) $(addprefix --high ,$(BG_PACKAGE_HIGH_$(1)))
endef
$(foreach p,$(filter-out $(OBJ_SHEET_PACKAGES),$(BG_PACKAGES)),$(eval $(call BG_PACKAGE_GRIT_RULE,$(p))))
$(foreach p,$(BG_PACKAGES),$(eval $(call BG_PACKAGE_RULE,$(p))))

# The sprite banks (GRAPHICS_DIR/sprites/bankNN_<name>/, docs/graphics.md
# "Sprite banks"): a PNG per frame and bank.json per bank.
# tools/sprite_frames.py pack cuts the frames into the tile pool, one
# tiles .inc per bank, generates the frames' piece arrays (a pieces .inc
# per bank) and sprite_frames.h with each frame's tile offset. One run for
# all banks, since a bank's offset depends on every earlier bank's size.
SPRITE_FRAMES := python3 tools/sprite_frames.py$(if $(filter-out graphics,$(GRAPHICS_DIR)), --graphics-dir $(GRAPHICS_DIR))
SPRITE_BANK_DIRS := $(sort $(wildcard $(GRAPHICS_DIR)/sprites/bank[0-9][0-9]_*))
SPRITE_FRAME_SOURCES := $(foreach d,$(SPRITE_BANK_DIRS),$(d)/bank.json $(wildcard $(d)/f*.png))
SPRITE_FRAMES_DIR := $(GRAPHICS_BUILDDIR)/sprites
SPRITE_FRAMES_OUT := $(SPRITE_FRAMES_DIR)/sprite_frames.h \
	$(foreach d,$(SPRITE_BANK_DIRS),$(SPRITE_FRAMES_DIR)/$(word 1,$(subst _, ,$(notdir $(d))))_tiles.inc \
	$(SPRITE_FRAMES_DIR)/$(word 1,$(subst _, ,$(notdir $(d))))_pieces.inc)
$(SPRITE_FRAMES_OUT) &: $(SPRITE_FRAME_SOURCES) tools/sprite_frames.py
	$(SPRITE_FRAMES) pack $(SPRITE_FRAMES_DIR)

# The OBJ palettes (gObjPalettes): one JASC file per paletteId,
# GRAPHICS_DIR/sprites/palettes/NNN_<owner>.pal (NNN the paletteId, <owner>
# the first sprite bank whose animations use it, or `unused`), back to
# back in index order.
OBJ_PALETTE_PALS := $(sort $(wildcard $(GRAPHICS_DIR)/sprites/palettes/*.pal))
$(GRAPHICS_BUILDDIR)/sprites/obj_palettes.bin: $(patsubst $(GRAPHICS_DIR)/%.pal,$(GRAPHICS_BUILDDIR)/%.gbapal,$(OBJ_PALETTE_PALS))
	@mkdir -p $(dir $@)
	cat $^ > $@
$(GRAPHICS_BUILDDIR)/sprites/obj_palettes.bin.inc: $(GRAPHICS_BUILDDIR)/sprites/obj_palettes.bin tools/bin2c.py
	python3 tools/bin2c.py $< $@

# The graphics classes (docs/graphics.md, "Graphics classes"): a graphic of
# the manifest with a `class` is that class, its parts static const data
# members. graphics.hpp declares them all (written only if it changed,
# behind a stamp, so a manifest edit that keeps it rebuilds nothing). Each
# object of the manifest's `objects` (GRAPHICS_CLASS_OBJECTS) #includes the
# definitions of the members in its ROM range, in ROM order, then those of
# the new graphics that name it, from <object>.inc, and depends on their
# bytes (graphics_manifest.mk).
GRAPHICS_CLASSES_HEADER := $(GENERATED_INCLUDE_DIR)/graphics.hpp
GENERATED_HEADERS += $(GRAPHICS_CLASSES_HEADER)
$(GRAPHICS_CLASSES_HEADER).stamp: $(GRAPHICS_DIR)/manifest.json tools/gfx_manifest.py
	@mkdir -p $(dir $@)
	$(GFX_MANIFEST) header $(GRAPHICS_CLASSES_HEADER)
	@touch $@
$(GRAPHICS_CLASSES_HEADER): $(GRAPHICS_CLASSES_HEADER).stamp
	@test -f $@ || $(GFX_MANIFEST) header $@

define GRAPHICS_DEFS_RULE
$(GRAPHICS_BUILDDIR)/$(1).inc: $(GRAPHICS_DIR)/manifest.json tools/gfx_manifest.py
	$(GFX_MANIFEST) defs $(1) $$@
$(call data_obj,$(1)): $(GRAPHICS_BUILDDIR)/$(1).inc
endef
$(foreach o,$(GRAPHICS_CLASS_OBJECTS),$(eval $(call GRAPHICS_DEFS_RULE,$(o))))
