{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Almamu/CrashBandicootXS-decomp/raw/main/packages/crashdata/schemas/crate_kinds.schema.json",
  "title": "The crate kinds (crate_kinds.json)",
  "description": "games/xs/data/levels/crate_kinds.json: CRATE_KIND_*",
  "type": "object",
  "properties": {
    "kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "comment": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kinds"
  ],
  "additionalProperties": false
}
