{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Almamu/CrashBandicootXS-decomp/raw/main/packages/crashdata/schemas/entity_types.schema.json",
  "title": "The entity types (entity_types.json)",
  "description": "games/<game>/data/levels/entity_types.json (docs/levels.md, \"Entity types\")",
  "type": "object",
  "properties": {
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$",
                "description": "ENTITY_<name>"
              },
              {
                "type": "null"
              }
            ]
          },
          "spawner": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "comment": {
            "type": "string"
          },
          "enemy_kind": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "enemy_kind_name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "params": {
            "enum": [
              "flags",
              "patrol",
              "cycle",
              "attack_first",
              "range_cycle",
              "range_attack_first",
              "range_homing_y",
              "wave",
              "homing_x",
              "homing_xy",
              "platform",
              "crate",
              "iron_switch_crate",
              "outline_crate",
              "n2_crate",
              "n2_iron_switch_crate",
              "n2_outline_crate",
              "patrol_xy",
              "patrol_y",
              "platform_group",
              "circle_platform",
              "group",
              "group_state",
              "width",
              "path_point",
              "path",
              "hint_text"
            ],
            "description": "the view of its parameter records its spawner reads (crashdata.levels.params)"
          }
        },
        "required": [
          "type",
          "name",
          "spawner"
        ],
        "additionalProperties": false
      },
      "description": "one per gEntitySpawnFuncs slot, in type order"
    }
  },
  "required": [
    "types"
  ],
  "additionalProperties": false
}
