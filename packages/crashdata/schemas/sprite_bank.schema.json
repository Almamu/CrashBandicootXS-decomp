{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Almamu/CrashBandicootXS-decomp/raw/main/packages/crashdata/schemas/sprite_bank.schema.json",
  "title": "A sprite bank's frames (bank.json)",
  "description": "games/<game>/graphics/sprites/bankNN_<name>/bank.json (docs/graphics.md, \"Sprite banks\")",
  "type": "object",
  "properties": {
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -32768,
              "maximum": 32767
            },
            "minItems": 2,
            "maxItems": 2
          },
          "pieces": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "enum": [
                    "16x16",
                    "16x32",
                    "16x8",
                    "32x16",
                    "32x32",
                    "32x64",
                    "32x8",
                    "64x32",
                    "64x64",
                    "8x16",
                    "8x32",
                    "8x8"
                  ],
                  "description": "its size in pixels, WxH"
                },
                {
                  "type": "integer",
                  "minimum": -32768,
                  "maximum": 32767
                },
                {
                  "type": "integer",
                  "minimum": -32768,
                  "maximum": 32767
                },
                {
                  "const": "own_png"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 4,
              "description": "[\"WxH\", x, y] from the sprite's position, or with \"own_png\""
            }
          },
          "layout": {
            "enum": [
              0,
              1,
              2,
              3,
              4,
              5,
              6
            ],
            "description": "the layout type, which struct the frame is"
          },
          "tiles": {
            "anyOf": [
              {
                "const": "own"
              },
              {
                "type": "object",
                "properties": {
                  "frame": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "tile": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "bank": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                },
                "required": [
                  "frame",
                  "tile"
                ],
                "additionalProperties": false
              }
            ],
            "description": "where the frame's tile run starts in the pool"
          },
          "palettes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "description": "the paletteIds of the animations that show it"
          },
          "boxes": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": -32768,
                "maximum": 32767
              },
              "minItems": 4,
              "maxItems": 4
            },
            "description": "a new frame's boxes, [x, y, w, h]"
          },
          "anchor": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -32768,
              "maximum": 32767
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "a new frame's anchor"
          }
        },
        "required": [
          "pieces",
          "tiles"
        ],
        "additionalProperties": false
      },
      "description": "in frame order"
    },
    "new_steps": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        }
      },
      "additionalProperties": false,
      "description": "{animation: [frame, ...]}: frames appended to its sequence"
    }
  },
  "required": [
    "frames"
  ],
  "additionalProperties": false
}
