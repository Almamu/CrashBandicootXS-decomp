+/* LOCAL (agbcc_arm_patched): Return nonzero if -mleaf-no-lr-save drops
+   lr from the current function's register save.  Stock 2.9-arm-000512
+   pushes lr along with any other saved register ("If we have to push
+   any regs, then we must push lr as well"), because its returns pop the
+   return address into pc or ip.  When lr is never used or clobbered
+   (no calls, not allocated) and there is no frame, lr still holds the
+   return address at the end, so the push can leave it out and the
+   epilogue can return with `bx lr' (or `mov pc, lr').  */
+int
+arm_lr_save_skipped ()
+{
+  return (TARGET_LEAF_NO_LR_SAVE
+	  && ! frame_pointer_needed
+	  && ! regs_ever_live[14]);
+}
