 #define TARGET_LONG_CALLS		(target_flags & ARM_FLAG_LONG_CALLS)
+#define TARGET_LEAF_NO_LR_SAVE		(target_flags & ARM_FLAG_LEAF_NO_LR_SAVE)
+#define TARGET_INTERWORK_RETURN_LR	(target_flags & ARM_FLAG_INTERWORK_RETURN_LR)
 
 /* SUBTARGET_SWITCHES is used to add flags on a per-config basis.
    Bit 31 is reserved.  See riscix.h.  */
@@ -420,6 +432,14 @@
   {"long-calls",		ARM_FLAG_LONG_CALLS,	\
    "Generate all call instructions as indirect calls"},	\
   {"no-long-calls",	       -ARM_FLAG_LONG_CALLS, ""}, \
+  /* LOCAL (agbcc_arm_patched) */			\
+  {"leaf-no-lr-save",		ARM_FLAG_LEAF_NO_LR_SAVE, \
+   "Do not save lr with other registers when lr is never used"}, \
+  {"no-leaf-no-lr-save",       -ARM_FLAG_LEAF_NO_LR_SAVE, ""}, \
+  {"interwork-return-lr",	ARM_FLAG_INTERWORK_RETURN_LR, \
+   "Interworking return insns pop into lr and use bx lr"}, \
